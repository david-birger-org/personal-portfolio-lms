NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional legacy alias supported by the app:
# NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_token

# lms-sls backend: contact-request intake, transactional mail, product catalog.
LMS_SLS_URL=https://api.yourdomain.com
# Narrowly-scoped service key for contact/mail (backend PUBLIC_API_KEY).
# Falls back to INTERNAL_API_KEY when unset, for migration.
LMS_SLS_PUBLIC_API_KEY=
INTERNAL_API_KEY=
# Admin app origin used to build checkout deep links.
NEXT_PUBLIC_ADMIN_URL=https://app.yourdomain.com
